msgstr ""
"Klikk <gui>Lim inn spesial</gui> i undermenyen <gui>Rediger</gui> i "
"<gui>Hovudmenyen</gui>, eller"

#. (itstool) path: item/p
#: C/advanced-clipboard.page:54
msgid "Press <keyseq><key>Shift</key><key>Ctrl</key><key>V</key></keyseq>."
msgstr "Trykk <keyseq><key>Shift</key><key>Ctrl</key><key>V</key></keyseq>."

#. (itstool) path: section/p
#: C/advanced-clipboard.page:57
msgid ""
"The options that appear when <gui>Paste Special</gui> is activated are "
"context-dependent."
msgstr ""
"Kva alternativ som dukkar opp når du vel <gui>Lim inn spesial</gui>, avheng "
